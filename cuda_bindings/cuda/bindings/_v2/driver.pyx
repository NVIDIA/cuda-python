class DriverError(Exception):
    def __init__(self, status):
        self.status = status
        s = Result(status)
        cdef str err = f"{s.name} ({s.value})"
        super(DriverError, self).__init__(err)

    def __reduce__(self):
        return (type(self), (self.status,))

