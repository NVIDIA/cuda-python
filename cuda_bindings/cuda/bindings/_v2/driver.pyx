    check_status(__status__)


cpdef logical_endpoint_import(uint32_t le_id, handle, int handle_type):
    """Imports a logical endpoint from the given IPC handle and associates it with a logical endpoint id.

    Imports a logical endpoint from the given IPC ``handle`` and associates it
    with the logical endpoint id specified by ``le_id``.

    If the current process cannot support the logical endpoint described by the
    shareable handle, this API will error as ``CUDA_ERROR_NOT_SUPPORTED``. If
    ``handle`` is of type ``CU_LOGICAL_ENDPOINT_IPC_HANDLE_TYPE_FABRIC`` and
