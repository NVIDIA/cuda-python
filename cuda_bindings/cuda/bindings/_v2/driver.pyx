    with nogil:
        __status__ = cuMemcpyBatchAsync(<CUdeviceptr*>dsts, <CUdeviceptr*>srcs, <size_t*>sizes, count, <CUmemcpyAttributes*>_attrs_ptr_, <size_t*>attrs_idxs, num_attrs, <CUstream>h_stream)
    check_status(__status__)


