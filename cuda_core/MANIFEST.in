recursive-include cuda/core *.pyx *.pxd *.pxi *.pyi
recursive-include cuda/core/_cpp *.cpp *.h *.hpp
recursive-include cuda/core/_include *.h *.hpp
include cuda/core/py.typed
include NOTICE
# setuptools-scm only records the submodule gitlink, so the checkout must be
# grafted or wheel-from-sdist has no CCCL headers. Prune .git so the sdist
# does not ship a pointer into this repository.
graft third_party/cccl
prune third_party/cccl/.git
