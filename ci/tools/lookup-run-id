# A utility script to find a GitHub Actions workflow run ID.
#
# Two modes:
#   --tag <tag>      Find the successful CI run triggered by a tag push.
#   --branch <branch> Find the latest qualifying successful CI run on a branch.
#
# Outputs the run ID on stdout.  All diagnostic messages go to stderr.
# When --head-sha is passed, a second line with the run's head SHA is printed.

set -euo pipefail

usage() {
    cat >&2 <<EOF
Usage:
  $0 --tag <git-tag> <repository> [workflow-name]
  $0 --branch <branch> <repository> [workflow-name]

Options:
  --tag <tag>        Find run by git tag (requires local git repo with the tag)
  --branch <branch>  Find latest successful run on the given branch
  --artifact <glob>  Require an unexpired artifact matching this shell glob
                     (repeatable; branch mode only)
  --head-sha         Also print the run's head commit SHA (second line)

Examples:
  $0 --tag v13.0.1 NVIDIA/cuda-python
  $0 --branch main NVIDIA/cuda-python
  $0 --branch 12.9.x --artifact 'cuda-bindings-python313-*' NVIDIA/cuda-python
  $0 --branch main --head-sha NVIDIA/cuda-python "CI"
EOF
    exit 1
}

# ── Parse arguments ──
MODE=""
REF=""
HEAD_SHA_FLAG=0
ARTIFACT_PATTERNS=()

while [[ $# -gt 0 ]]; do
    case "${1}" in
        --tag)
            [[ $# -ge 2 ]] || usage
            [[ -n "${MODE}" && "${MODE}" != "tag" ]] && { echo "Error: --tag and --branch are mutually exclusive" >&2; exit 1; }
            MODE="tag"; REF="${2}"; shift 2 ;;
        --branch)
            [[ $# -ge 2 ]] || usage
            [[ -n "${MODE}" && "${MODE}" != "branch" ]] && { echo "Error: --tag and --branch are mutually exclusive" >&2; exit 1; }
            MODE="branch"; REF="${2}"; shift 2 ;;
        --artifact)
            [[ $# -ge 2 ]] || usage
            ARTIFACT_PATTERNS+=("${2}"); shift 2 ;;
        --head-sha)
            HEAD_SHA_FLAG=1; shift ;;
        -h|--help)
            usage ;;
        *)
            break ;;
    esac
done

if [[ -z "${MODE}" ]]; then
    # Legacy positional interface: <git-tag> <repository> [workflow-name]
    # Kept for backward compatibility with release.yml.
    if [[ $# -lt 2 ]]; then usage; fi
    MODE="tag"
    REF="${1}"; shift
fi

REPOSITORY="${1:-}"; shift || true
WORKFLOW_NAME="${1:-CI}"

if [[ -z "${REPOSITORY}" ]]; then usage; fi

if [[ "${MODE}" != "branch" && ${#ARTIFACT_PATTERNS[@]} -gt 0 ]]; then
    echo "Error: --artifact is only supported with --branch" >&2
    exit 1
fi

# ── Prerequisite checks ──
if [[ -z "${GH_TOKEN:-}" ]]; then
    echo "Error: GH_TOKEN environment variable is required" >&2
    exit 1
fi

for cmd in jq gh; do
    if ! command -v "${cmd}" >/dev/null 2>&1; then
        echo "Error: ${cmd} is required but not installed" >&2
        exit 1
    fi
done

# ── Mode: branch ──
if [[ "${MODE}" == "branch" ]]; then
    echo "Looking up latest successful '${WORKFLOW_NAME}' run on branch: ${REF}" >&2

    WORKFLOW_API_ID=$(gh api --paginate \
        "repos/${REPOSITORY}/actions/workflows?per_page=100" \
        --jq '.workflows[] | {id, name, path}' \
        | jq -sr --arg selector "${WORKFLOW_NAME}" '
            map(select(
                (.id | tostring) == $selector
                or .name == $selector
                or (.path // "") == $selector
                or ((.path // "") | split("/") | last) == $selector
            ))
            | .[0].id // empty
        ')

    if [[ -z "${WORKFLOW_API_ID}" ]]; then
        echo "Error: Could not resolve workflow '${WORKFLOW_NAME}' in repository '${REPOSITORY}'" >&2
        exit 1
    fi

    REF_API=$(jq -rn --arg ref "${REF}" '$ref | @uri')
    BRANCH_HEAD_SHA=$(gh api "repos/${REPOSITORY}/branches/${REF_API}" --jq '.commit.sha // empty')
    if [[ -z "${BRANCH_HEAD_SHA}" ]]; then
        echo "Error: Could not resolve branch '${REF}' in repository '${REPOSITORY}'" >&2
        exit 1
    fi

    STALE_RUN_HOURS="${LOOKUP_RUN_ID_STALE_HOURS:-72}"
    STALE_RUN_SECONDS=$((STALE_RUN_HOURS * 3600))
    RETRY_SECONDS="${LOOKUP_RUN_ID_RETRY_SECONDS:-2}"

    normalize_runs_jq='[
        .workflow_runs[] | {
            databaseId: .id,
            workflowName: (.name // ""),
            status: (.status // ""),
            conclusion: (.conclusion // ""),
            headSha: (.head_sha // ""),
            headBranch: (.head_branch // ""),
            createdAt: (.created_at // ""),
            url: (.html_url // .url // "")
        }
    ]'

    fetch_run_data() {
        RUN_LIST_DATA=$(gh run list \
            --repo "${REPOSITORY}" \
            --workflow "${WORKFLOW_NAME}" \
            --json databaseId,workflowName,status,conclusion,headSha,headBranch,createdAt,url \
            --limit 100)

        HEAD_RUN_DATA=$(gh api --method GET \
            "repos/${REPOSITORY}/actions/workflows/${WORKFLOW_API_ID}/runs" \
            -f "head_sha=${BRANCH_HEAD_SHA}" \
            -F "per_page=100" \
            --jq "${normalize_runs_jq}")

        REST_RUN_DATA=$(gh api --method GET \
            "repos/${REPOSITORY}/actions/workflows/${WORKFLOW_API_ID}/runs" \
            -F "per_page=100" \
            --jq "${normalize_runs_jq}")

        RUN_DATA=$(printf '%s\n%s\n%s\n' "${HEAD_RUN_DATA}" "${RUN_LIST_DATA}" "${REST_RUN_DATA}" | jq -s '
            add
            | group_by(.databaseId)
            | map(
                sort_by(
                    if .conclusion == "success" then 1 else 0 end,
                    if .status == "completed" then 1 else 0 end,
                    (.createdAt // "")
                )
                | .[-1]
            )
        ')

        CANDIDATE_RUNS=$(echo "${RUN_DATA}" | jq -r \
            --arg branch "${REF}" \
            --arg branch_head_sha "${BRANCH_HEAD_SHA}" '
            map(select(
                .headBranch == $branch
                and .conclusion == "success"
            ))
            | sort_by(
                if .headSha == $branch_head_sha then 1 else 0 end,
                .createdAt,
                .databaseId
            )
            | reverse
            | .[]
            | [.databaseId, .headSha, .createdAt]
            | @tsv
        ')
    }

    is_stale_without_artifacts() {
        local candidate_sha="${1}"
        local candidate_created_at="${2}"
        local created_epoch
        local now_epoch

        [[ ${#ARTIFACT_PATTERNS[@]} -eq 0 ]] || return 1
        [[ "${candidate_sha}" != "${BRANCH_HEAD_SHA}" ]] || return 1

        created_epoch=$(date -u -d "${candidate_created_at}" +%s 2>/dev/null || true)
        [[ -n "${created_epoch}" ]] || return 1

        now_epoch=$(date -u +%s)
        ((now_epoch - created_epoch > STALE_RUN_SECONDS))
    }

    fetch_run_data

    FIRST_CANDIDATE=$(echo "${CANDIDATE_RUNS}" | head -n 1 || true)
    if [[ -n "${FIRST_CANDIDATE}" ]]; then
        IFS=$'\t' read -r first_candidate_id first_candidate_sha first_candidate_created_at <<< "${FIRST_CANDIDATE}"
        if is_stale_without_artifacts "${first_candidate_sha}" "${first_candidate_created_at}"; then
            echo "Newest candidate run ${first_candidate_id} (${first_candidate_created_at}) is older than ${STALE_RUN_HOURS} hours and is not branch HEAD; retrying run lookup once" >&2
            sleep "${RETRY_SECONDS}"
            fetch_run_data
        fi
    fi

    if [[ -z "${CANDIDATE_RUNS}" ]]; then
        echo "Error: No successful '${WORKFLOW_NAME}' run found on branch '${REF}'" >&2
        echo "Branch HEAD: ${BRANCH_HEAD_SHA}" >&2
        exit 1
    fi

    if [[ ${#ARTIFACT_PATTERNS[@]} -gt 0 ]]; then
        echo "Requiring unexpired artifacts matching:" >&2
        printf '  - %s\n' "${ARTIFACT_PATTERNS[@]}" >&2
    fi

    RUN_ID=""
    HEAD_SHA=""
    while IFS= read -r candidate; do
        IFS=$'\t' read -r candidate_id candidate_sha candidate_created_at <<< "${candidate}"

        if is_stale_without_artifacts "${candidate_sha}" "${candidate_created_at}"; then
            echo "Skipping run ${candidate_id} (${candidate_created_at}); not branch HEAD (${BRANCH_HEAD_SHA}) and older than ${STALE_RUN_HOURS} hours" >&2
            continue
        fi

        missing_patterns=()
        if [[ ${#ARTIFACT_PATTERNS[@]} -gt 0 ]]; then
            if ! ARTIFACT_NAMES=$(gh api --paginate \
                "repos/${REPOSITORY}/actions/runs/${candidate_id}/artifacts?per_page=100" \
                --jq '.artifacts[] | select(.expired == false) | .name'); then
                echo "Error: Failed to list artifacts for run ${candidate_id}" >&2
                exit 1
            fi

            for pattern in "${ARTIFACT_PATTERNS[@]}"; do
                pattern_matched=0
                while IFS= read -r artifact_name; do
                    # The caller supplies a shell glob, so the RHS must remain unquoted.
                    # shellcheck disable=SC2053
                    if [[ -n "${artifact_name}" && "${artifact_name}" == ${pattern} ]]; then
                        pattern_matched=1
                        break
                    fi
                done <<< "${ARTIFACT_NAMES}"
                if [[ ${pattern_matched} == 0 ]]; then
                    missing_patterns+=("${pattern}")
                fi
            done
        fi

        if [[ ${#missing_patterns[@]} -gt 0 ]]; then
            echo "Skipping run ${candidate_id} (${candidate_created_at}); missing unexpired artifact(s): ${missing_patterns[*]}" >&2
            continue
        fi

        RUN_ID="${candidate_id}"
        HEAD_SHA="${candidate_sha}"
        break
    done <<< "${CANDIDATE_RUNS}"

    if [[ -z "${RUN_ID}" ]]; then
        if [[ ${#ARTIFACT_PATTERNS[@]} -gt 0 ]]; then
            echo "Error: No successful '${WORKFLOW_NAME}' run on branch '${REF}' has all required artifacts" >&2
        else
            echo "Error: No recent successful '${WORKFLOW_NAME}' run found on branch '${REF}'" >&2
            echo "Branch HEAD: ${BRANCH_HEAD_SHA}" >&2
        fi
        echo "Candidate runs considered:" >&2
        echo "${CANDIDATE_RUNS}" | awk -F '\t' '{ printf "  - id=%s headSha=%s createdAt=%s\n", $1, $2, $3 }' >&2
        exit 1
    fi

    echo "Found run ID: ${RUN_ID}" >&2
    echo "${RUN_ID}"

    if [[ "${HEAD_SHA_FLAG}" == 1 ]]; then
        if [[ -z "${HEAD_SHA}" ]]; then
            echo "Error: Run ${RUN_ID} has no head SHA" >&2
            exit 1
        fi
        echo "Head SHA: ${HEAD_SHA}" >&2
        echo "${HEAD_SHA}"
    fi
    exit 0
fi

# ── Mode: tag ──
echo "Looking up run ID for tag: ${REF} in repository: ${REPOSITORY}" >&2

if ! COMMIT_SHA=$(git rev-parse "${REF}^{commit}"); then
    echo "Error: Could not resolve git tag '${REF}' to a commit SHA" >&2
    echo "Make sure the tag exists and you have fetched it" >&2
    exit 1
fi

echo "Resolved tag '${REF}' to commit: ${COMMIT_SHA}" >&2
echo "Searching for '${WORKFLOW_NAME}' workflow runs for commit: ${COMMIT_SHA} (tag: ${REF})" >&2

RUN_DATA=$(gh run list \
    --repo "${REPOSITORY}" \
    --commit "${COMMIT_SHA}" \
    --workflow "${WORKFLOW_NAME}" \
    --json databaseId,workflowName,status,conclusion,headSha,headBranch,event,createdAt,url \
    --jq 'map(select(.status == "completed"))' \
    --limit 50)

if [[ -z "${RUN_DATA}" || "${RUN_DATA}" == "[]" ]]; then
    echo "Error: No completed '${WORKFLOW_NAME}' workflow runs found for commit ${COMMIT_SHA}" >&2
    echo "Available workflow runs for this commit:" >&2
    gh run list --repo "${REPOSITORY}" --commit "${COMMIT_SHA}" --limit 10 || true
    exit 1
fi

RUN_ID=$(echo "${RUN_DATA}" | jq -r --arg tag "${REF}" '
    map(select(.conclusion == "success" and .event == "push" and .headBranch == $tag))
    | sort_by(.createdAt)
    | reverse
    | .[0].databaseId // empty
')

if [[ -z "${RUN_ID}" ]]; then
    echo "Error: No successful '${WORKFLOW_NAME}' workflow runs found for tag '${REF}'." >&2
    echo "This release workflow now requires artifacts from a tag-triggered CI run." >&2
    echo "If you just pushed the tag, wait for CI on that tag to finish and retry." >&2
    echo "" >&2
    echo "Completed runs for commit ${COMMIT_SHA}:" >&2
    echo "${RUN_DATA}" | jq -r '.[] | "\(.databaseId): event=\(.event // "null"), headBranch=\(.headBranch // "null"), conclusion=\(.conclusion // "null"), status=\(.status // "null"), createdAt=\(.createdAt // "null")"' >&2
    exit 1
fi

echo "Found workflow run ID: ${RUN_ID} for tag '${REF}'" >&2

echo "Verifying artifacts exist for run ${RUN_ID}..." >&2
ARTIFACT_LIST=$(gh run view "${RUN_ID}" --repo "${REPOSITORY}" --json url || echo "")

if [[ -z "${ARTIFACT_LIST}" ]]; then
    echo "Warning: Could not verify artifacts for workflow run ${RUN_ID}" >&2
fi

echo "${RUN_ID}"

if [[ "${HEAD_SHA_FLAG}" == 1 ]]; then
    HEAD_SHA=$(echo "${RUN_DATA}" | jq -r --arg id "${RUN_ID}" '
        map(select(.databaseId == ($id | tonumber))) | .[0].headSha // empty')
    echo "Head SHA: ${HEAD_SHA}" >&2
    echo "${HEAD_SHA}"
fi
