# A utility script to download component wheels from GitHub Actions artifacts.
# This script reuses the same logic that was in release.yml to maintain consistency.

set -euo pipefail

# Retry gh run download with exponential backoff to absorb transient
# artifact-storage failures such as "HTTP 503: Egress is over the account limit".
#
# Downloads into a private staging directory and promotes the artifacts to CWD
# on success.  The staging directory is wiped before each retry so that
# artifact directories left behind by a partial download do not cause gh to
# refuse to re-download them on subsequent attempts.  Staging lives under
# RUNNER_TEMP, which the runner empties at the start and end of every job, so
# a killed or cancelled step cannot leak it.
_retry_gh_run_download() {
    local max_attempts=5
    local delay=15
    local max_delay=120
    local attempt=1
    local staging
    staging=$(mktemp -d -p "${RUNNER_TEMP:-/tmp}")

    until gh run download "$@" -D "${staging}"; do
        rm -rf "${staging}"
        if (( attempt >= max_attempts )); then
            echo "::error::gh run download failed after ${attempt} attempt(s): $*" >&2
            return 1
        fi
        echo "::warning::gh run download failed (attempt ${attempt}/${max_attempts}); retrying in ${delay}s" >&2
        sleep "${delay}"
        attempt=$(( attempt + 1 ))
        (( delay = delay * 2 > max_delay ? max_delay : delay * 2 ))
        staging=$(mktemp -d -p "${RUNNER_TEMP:-/tmp}")
    done

    # Promote each downloaded artifact directory into the caller's CWD.
    for artifact_dir in "${staging}"/*/; do
        mv "${artifact_dir%/}" .
    done
    rm -rf "${staging}"
}

# Check required arguments
if [[ $# -lt 3 ]]; then
    echo "Usage: $0 <run-id> <component> <repository> [output-dir]" >&2
    echo "  run-id: The GitHub Actions run ID containing the artifacts" >&2
    echo "  component: The component name pattern to download (e.g., cuda-core, cuda-bindings)" >&2
    echo "  repository: The GitHub repository (e.g., NVIDIA/cuda-python)" >&2
    echo "  output-dir: Optional output directory (default: ./dist)" >&2
    exit 1
fi

RUN_ID="$1"
COMPONENT="$2"
REPOSITORY="$3"
OUTPUT_DIR="${4:-./dist}"

# Ensure we have a GitHub token
if [[ -z "${GH_TOKEN:-}" ]]; then
    echo "Error: GH_TOKEN environment variable is required"
    exit 1
fi

echo "Downloading wheels for component: $COMPONENT from run: $RUN_ID"

# Download component wheels using the same logic as release.yml
if [[ "$COMPONENT" == "all" ]]; then
    # Download all component patterns
    _retry_gh_run_download "$RUN_ID" -p "cuda-*" -R "$REPOSITORY"
else
    _retry_gh_run_download "$RUN_ID" -p "${COMPONENT}*" -R "$REPOSITORY"
fi

# Create output directory
mkdir -p "$OUTPUT_DIR"

# Process downloaded artifacts
for p in cuda-*
do
    if [[ ! -d "$p" ]]; then
        continue
    fi

    # exclude cython test artifacts
    if [[ "${p}" == *-tests ]]; then
        echo "Skipping test artifact: $p"
        continue
    fi

    # If we're not downloading "all", only process matching component
    if [[ "$COMPONENT" != "all" && "$p" != ${COMPONENT}* ]]; then
        continue
    fi

    echo "Processing artifact: $p"
    # Move wheel files to output directory
    if [[ -d "$p" ]]; then
        find "$p" -name "*.whl" -exec mv {} "$OUTPUT_DIR/" \;
    fi
done

# Clean up artifact directories
rm -rf cuda-*

echo "Downloaded wheels to: $OUTPUT_DIR"
ls -la "$OUTPUT_DIR"
