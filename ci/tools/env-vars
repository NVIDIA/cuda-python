# A utility script to set up the GitHub environment variables for the CI.

set -euo pipefail

# Check if the script was called with exactly 1 argument
if [[ ${#} -ne 1 ]]; then
  echo "Error: This script requires exactly 1 argument (the build mode). You provided ${#}"
  echo "Usage: ${0} build_mode[build or test]"
  exit 1
fi

PYTHON_VERSION_FORMATTED=$(echo "${PY_VER}" | tr -d '.')

if [[ "${HOST_PLATFORM}" == linux* ]]; then
  REPO_DIR=$(pwd)
  TOOLS_PATH="${REPO_DIR}/ci/tools"
elif [[ "${HOST_PLATFORM}" == win* ]]; then
  PWD=$(pwd)
  REPO_DIR=$(cygpath -w ${PWD})
  TOOLS_PATH=$(cygpath -w ${PWD}/ci/tools)
fi

echo "${TOOLS_PATH}" >> $GITHUB_PATH
echo "CUDA_PYTHON_PARALLEL_LEVEL=$(nproc)" >> $GITHUB_ENV
CUDA_CORE_ARTIFACT_BASENAME="cuda-core-python${PYTHON_VERSION_FORMATTED}-${HOST_PLATFORM}"
CUDA_CORE_ARTIFACT_NAME="${CUDA_CORE_ARTIFACT_BASENAME}-${SHA}"
{
  echo "CUDA_CORE_ARTIFACT_BASENAME=${CUDA_CORE_ARTIFACT_BASENAME}"
  echo "CUDA_CORE_ARTIFACT_NAME=${CUDA_CORE_ARTIFACT_NAME}"
  echo "CUDA_CORE_ARTIFACTS_DIR=$(realpath "${REPO_DIR}/cuda_core/dist")"
  echo "CUDA_CORE_CYTHON_TESTS_DIR=$(realpath "${REPO_DIR}/cuda_core/tests/cython")"
  echo "CUDA_CORE_TEST_BINARIES_DIR=$(realpath "${REPO_DIR}/cuda_core/tests/test_binaries")"
  echo "PYTHON_VERSION_FORMATTED=${PYTHON_VERSION_FORMATTED}"
} >> $GITHUB_ENV

if [[ "${1}" == "build" ]]; then
  # platform is handled by the default value of platform (`auto`) in cibuildwheel
  # here we only need to specify the python version we want
  echo "CIBW_BUILD=cp${PYTHON_VERSION_FORMATTED}-*" >> $GITHUB_ENV
  CURRENT_LINE_JSON="$(python -m ci.tools.bindings_config --role current)"
  MAINTENANCE_LINE_JSON="$(python -m ci.tools.bindings_config --role maintenance)"
  json_field() {
    python -c 'import json, sys; print(json.load(sys.stdin)[sys.argv[1]])' "$1"
  }
  CURRENT_LINE_ID="$(json_field line_id <<< "${CURRENT_LINE_JSON}")"
  CURRENT_BINDINGS_ROOT="$(json_field source_dir <<< "${CURRENT_LINE_JSON}")"
  CURRENT_CUDA_VERSION="$(json_field toolkit_version <<< "${CURRENT_LINE_JSON}")"
  CURRENT_CUDA_MAJOR="$(json_field cuda_major <<< "${CURRENT_LINE_JSON}")"
  CURRENT_CUDA_VARIANT="$(json_field cuda_variant <<< "${CURRENT_LINE_JSON}")"
  MAINTENANCE_LINE_ID="$(json_field line_id <<< "${MAINTENANCE_LINE_JSON}")"
  MAINTENANCE_BINDINGS_ROOT="$(json_field source_dir <<< "${MAINTENANCE_LINE_JSON}")"
  MAINTENANCE_CUDA_VERSION="$(json_field toolkit_version <<< "${MAINTENANCE_LINE_JSON}")"
  MAINTENANCE_CUDA_MAJOR="$(json_field cuda_major <<< "${MAINTENANCE_LINE_JSON}")"
  MAINTENANCE_CUDA_VARIANT="$(json_field cuda_variant <<< "${MAINTENANCE_LINE_JSON}")"
  if [[ "${CURRENT_CUDA_MAJOR}" == "${MAINTENANCE_CUDA_MAJOR}" ]]; then
    echo "Error: the monolithic wheel builder requires current and maintenance lines with distinct CUDA ABI majors" >&2
    exit 1
  fi

  CURRENT_BINDINGS_ARTIFACT_BASENAME="cuda-bindings-python${PYTHON_VERSION_FORMATTED}-cuda${CURRENT_CUDA_VERSION}-${HOST_PLATFORM}"
  MAINTENANCE_BINDINGS_ARTIFACT_BASENAME="cuda-bindings-python${PYTHON_VERSION_FORMATTED}-cuda${MAINTENANCE_CUDA_VERSION}-${HOST_PLATFORM}"
  CUDA_BINDINGS_ARTIFACT_BASENAME="${CURRENT_BINDINGS_ARTIFACT_BASENAME}"
  CUDA_BINDINGS_ARTIFACTS_DIR="$(realpath "${REPO_DIR}/${CURRENT_BINDINGS_ROOT}/dist")"
  CUDA_BINDINGS_CYTHON_TESTS_DIR="$(realpath "${REPO_DIR}/${CURRENT_BINDINGS_ROOT}/tests/cython")"
  MAINTENANCE_SCM_VERSION="$(python -m ci.tools.bindings_scm_version \
    --repo-root "${REPO_DIR}" \
    --line-id "${MAINTENANCE_LINE_ID}" \
    --sha "${SHA}")"
  MAINTENANCE_SCM_ENV=""
  if [[ -n "${MAINTENANCE_SCM_VERSION}" ]]; then
    MAINTENANCE_SCM_ENV="SETUPTOOLS_SCM_PRETEND_VERSION_FOR_CUDA_BINDINGS=${MAINTENANCE_SCM_VERSION}"
  fi

  {
    echo "CURRENT_LINE_ID=${CURRENT_LINE_ID}"
    echo "CURRENT_BINDINGS_ROOT=${CURRENT_BINDINGS_ROOT}"
    echo "CURRENT_CUDA_VERSION=${CURRENT_CUDA_VERSION}"
    echo "CURRENT_CUDA_MAJOR=${CURRENT_CUDA_MAJOR}"
    echo "CURRENT_CUDA_VARIANT=${CURRENT_CUDA_VARIANT}"
    echo "MAINTENANCE_LINE_ID=${MAINTENANCE_LINE_ID}"
    echo "MAINTENANCE_BINDINGS_ROOT=${MAINTENANCE_BINDINGS_ROOT}"
    echo "MAINTENANCE_CUDA_VERSION=${MAINTENANCE_CUDA_VERSION}"
    echo "MAINTENANCE_CUDA_MAJOR=${MAINTENANCE_CUDA_MAJOR}"
    echo "MAINTENANCE_CUDA_VARIANT=${MAINTENANCE_CUDA_VARIANT}"
    echo "MAINTENANCE_SCM_VERSION=${MAINTENANCE_SCM_VERSION}"
    echo "MAINTENANCE_SCM_ENV=${MAINTENANCE_SCM_ENV}"
    echo "CURRENT_BINDINGS_ARTIFACT_BASENAME=${CURRENT_BINDINGS_ARTIFACT_BASENAME}"
    echo "CURRENT_BINDINGS_ARTIFACT_NAME=${CURRENT_BINDINGS_ARTIFACT_BASENAME}-${SHA}"
    echo "CURRENT_BINDINGS_ARTIFACTS_DIR=$(realpath "${REPO_DIR}/${CURRENT_BINDINGS_ROOT}/dist")"
    echo "CURRENT_BINDINGS_CYTHON_TESTS_DIR=$(realpath "${REPO_DIR}/${CURRENT_BINDINGS_ROOT}/tests/cython")"
    echo "MAINTENANCE_BINDINGS_ARTIFACT_BASENAME=${MAINTENANCE_BINDINGS_ARTIFACT_BASENAME}"
    echo "MAINTENANCE_BINDINGS_ARTIFACT_NAME=${MAINTENANCE_BINDINGS_ARTIFACT_BASENAME}-${SHA}"
    echo "MAINTENANCE_BINDINGS_ARTIFACTS_DIR=$(realpath "${REPO_DIR}/${MAINTENANCE_BINDINGS_ROOT}/dist")"
    echo "MAINTENANCE_BINDINGS_CYTHON_TESTS_DIR=$(realpath "${REPO_DIR}/${MAINTENANCE_BINDINGS_ROOT}/tests/cython")"
    echo "CURRENT_PYTHON_ARTIFACT_NAME=cuda-python-wheel-cuda${CURRENT_CUDA_VERSION}"
    echo "MAINTENANCE_PYTHON_ARTIFACT_NAME=cuda-python-wheel-cuda${MAINTENANCE_CUDA_VERSION}"
  } >> $GITHUB_ENV
  # Enforce an explicit cache dir so that we can reuse this path later
  echo "SCCACHE_DIR=${HOME}/.cache/sccache" >> $GITHUB_ENV
  echo "SCCACHE_CACHE_SIZE=1G" >> $GITHUB_ENV
elif [[ "${1}" == "test" ]]; then
  TEST_CUDA_MAJOR="$(cut -d '.' -f 1 <<< "${CUDA_VER}")"

  # BINDINGS_SOURCE controls which cuda-bindings to install at test time:
  #   local     — use the matching configured-line wheel from this CI run
  #   published — install from PyPI (cuda-bindings==${TEST_CUDA_MAJOR}.${TEST_CUDA_MINOR}.*)
  #
  # SKIP_CUDA_BINDINGS_TEST / SKIP_CYTHON_TEST control which *tests* to run
  # (they do NOT affect installation — that's BINDINGS_SOURCE's job).

  TEST_CUDA_MINOR="$(cut -d '.' -f 2 <<< ${CUDA_VER})"

  if [[ "${PATHFINDER_SOURCE:-}" != "artifact" && "${PATHFINDER_SOURCE:-}" != "published" ]]; then
    echo "Error: PATHFINDER_SOURCE must be artifact or published, got ${PATHFINDER_SOURCE:-<unset>}" >&2
    exit 1
  fi

  if [[ "${BINDINGS_SOURCE}" == "local" ]]; then
    : "${BINDINGS_LINE_ID:?BINDINGS_LINE_ID is required for local bindings}"
    : "${BINDINGS_SOURCE_DIR:?BINDINGS_SOURCE_DIR is required for local bindings}"
    BINDINGS_BUILD_CUDA_VER="${CUDA_VER}"
    CUDA_BINDINGS_ROOT="${BINDINGS_SOURCE_DIR}"
  elif [[ "${BINDINGS_SOURCE}" == "published" ]]; then
    # Older minors use published bindings to exercise the supported
    # backward-compatibility path.
    : "${DEFAULT_BINDINGS_SOURCE_DIR:?DEFAULT_BINDINGS_SOURCE_DIR is required for published bindings}"
    CUDA_BINDINGS_ROOT="${DEFAULT_BINDINGS_SOURCE_DIR}"
    SKIP_CUDA_BINDINGS_TEST=1
    SKIP_CYTHON_TEST=1
  else
    echo "Error: BINDINGS_SOURCE must be local or published, got ${BINDINGS_SOURCE}" >&2
    exit 1
  fi

  if [[ "${BINDINGS_SOURCE}" == "local" ]]; then
    if [[ "${SKIP_BINDINGS_TEST_OVERRIDE:-0}" == "1" ]]; then
      SKIP_CUDA_BINDINGS_TEST=1
    else
      SKIP_CUDA_BINDINGS_TEST=0
    fi
    SKIP_CYTHON_TEST=0
    CUDA_BINDINGS_ARTIFACT_BASENAME="cuda-bindings-python${PYTHON_VERSION_FORMATTED}-cuda${BINDINGS_BUILD_CUDA_VER}-${HOST_PLATFORM}"
    CUDA_BINDINGS_ARTIFACTS_DIR="$(realpath "${REPO_DIR}/${CUDA_BINDINGS_ROOT}/dist")"
    CUDA_BINDINGS_CYTHON_TESTS_DIR="$(realpath "${REPO_DIR}/${CUDA_BINDINGS_ROOT}/tests/cython")"
    CUDA_PYTHON_ARTIFACT_NAME="cuda-python-wheel-cuda${BINDINGS_BUILD_CUDA_VER}"
  else
    # These are unused for published bindings, but deterministic paths make
    # environment dumps and ad-hoc invocations easier to understand.
    CUDA_BINDINGS_ARTIFACT_BASENAME="cuda-bindings-python${PYTHON_VERSION_FORMATTED}-cuda${CUDA_VER}-${HOST_PLATFORM}"
    CUDA_BINDINGS_ARTIFACTS_DIR="$(realpath "${REPO_DIR}/${CUDA_BINDINGS_ROOT}/dist")"
    CUDA_BINDINGS_CYTHON_TESTS_DIR="$(realpath "${REPO_DIR}/${CUDA_BINDINGS_ROOT}/tests/cython")"
  fi
  # We don't test compute-sanitizer on CTK<12 because backporting fixes is too much effort
  # We only test compute-sanitizer on python 3.12 arbitrarily; we don't need to use sanitizer on the entire matrix
  # Only local ctk installs have compute-sanitizer; there is no wheel for it
  if [[ "${PY_VER}" == "3.12" && "${CUDA_VER}" != "11.8.0" && "${LOCAL_CTK}" == 1 && "${HOST_PLATFORM}" == linux* ]]; then
    echo "LATEST_CUDA_VERSION=$(bash ci/tools/guess_latest.sh $TEST_CUDA_MAJOR)" >> $GITHUB_ENV
    SETUP_SANITIZER=1
  else
    SETUP_SANITIZER=0
    echo "SANITIZER_CMD=" >> $GITHUB_ENV
  fi
  {
    echo "SETUP_SANITIZER=${SETUP_SANITIZER}"
    echo "BINDINGS_SOURCE=${BINDINGS_SOURCE}"
    echo "CUDA_BINDINGS_ROOT=${CUDA_BINDINGS_ROOT}"
    echo "PATHFINDER_SOURCE=${PATHFINDER_SOURCE}"
    if [[ "${BINDINGS_SOURCE}" == "local" ]]; then
      echo "CUDA_PYTHON_ARTIFACT_NAME=${CUDA_PYTHON_ARTIFACT_NAME}"
    fi
    echo "SKIP_CUDA_BINDINGS_TEST=${SKIP_CUDA_BINDINGS_TEST}"
    echo "SKIP_CYTHON_TEST=${SKIP_CYTHON_TEST}"
    echo "TEST_CUDA_MAJOR=${TEST_CUDA_MAJOR}"
    echo "TEST_CUDA_MINOR=${TEST_CUDA_MINOR}"
  } >> $GITHUB_ENV
fi

: "${CUDA_BINDINGS_ARTIFACTS_DIR:?internal error: bindings artifact directory was not resolved}"
: "${CUDA_BINDINGS_CYTHON_TESTS_DIR:?internal error: bindings Cython test directory was not resolved}"
{
  echo "CUDA_BINDINGS_ARTIFACT_BASENAME=${CUDA_BINDINGS_ARTIFACT_BASENAME}"
  echo "CUDA_BINDINGS_ARTIFACT_NAME=${CUDA_BINDINGS_ARTIFACT_BASENAME}-${SHA}"
  echo "CUDA_BINDINGS_ARTIFACTS_DIR=${CUDA_BINDINGS_ARTIFACTS_DIR}"
  echo "CUDA_BINDINGS_CYTHON_TESTS_DIR=${CUDA_BINDINGS_CYTHON_TESTS_DIR}"
  echo "CUDA_CORE_CYTHON_TEST_ARTIFACT_NAME=${CUDA_CORE_ARTIFACT_NAME}-cu${TEST_CUDA_MAJOR:-${CURRENT_CUDA_MAJOR}}-tests"
} >> $GITHUB_ENV
