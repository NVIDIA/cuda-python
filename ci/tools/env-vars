# A utility script to set up the GitHub environment variables for the CI.

set -euo pipefail

if [[ ${#} -ne 1 || ( "${1}" != "build" && "${1}" != "test" ) ]]; then
  echo "Usage: ${0} {build|test}" >&2
  exit 1
fi
BUILD_MODE=${1}
PYTHON_VERSION_FORMATTED=$(echo "${PY_VER}" | tr -d '.')
CI_TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ "${HOST_PLATFORM}" == linux* ]]; then
  REPO_DIR=$(pwd)
  TOOLS_PATH="${CI_TOOLS_DIR}"
elif [[ "${HOST_PLATFORM}" == win* ]]; then
  REPO_DIR=$(cygpath -w "$(pwd)")
  TOOLS_PATH=$(cygpath -w "${CI_TOOLS_DIR}")
fi

echo "${TOOLS_PATH}" >> "$GITHUB_PATH"
echo "CUDA_PYTHON_PARALLEL_LEVEL=$(nproc)" >> "$GITHUB_ENV"
CUDA_CORE_ARTIFACT_BASENAME="cuda-core-python${PYTHON_VERSION_FORMATTED}-${HOST_PLATFORM}"
CUDA_CORE_ARTIFACT_NAME="${CUDA_CORE_ARTIFACT_BASENAME}-${SHA}"
{
  echo "CUDA_CORE_ARTIFACT_BASENAME=${CUDA_CORE_ARTIFACT_BASENAME}"
  echo "CUDA_CORE_ARTIFACT_NAME=${CUDA_CORE_ARTIFACT_NAME}"
  echo "CUDA_CORE_ARTIFACTS_DIR=$(realpath "${REPO_DIR}/cuda_core/dist")"
  echo "CUDA_CORE_CYTHON_TESTS_DIR=$(realpath "${REPO_DIR}/cuda_core/tests/cython")"
  echo "CUDA_CORE_TEST_BINARIES_DIR=$(realpath "${REPO_DIR}/cuda_core/tests/test_binaries")"
  echo "PYTHON_VERSION_FORMATTED=${PYTHON_VERSION_FORMATTED}"
} >> "$GITHUB_ENV"

if [[ "${BUILD_MODE}" == "build" ]]; then
  case "${HOST_PLATFORM}" in
    linux-64) CIBW_PLATFORM_TAG="manylinux_x86_64" ;;
    linux-aarch64) CIBW_PLATFORM_TAG="manylinux_aarch64" ;;
    win-64) CIBW_PLATFORM_TAG="win_amd64" ;;
    win-arm64) CIBW_PLATFORM_TAG="win_arm64" ;;
    *) echo "Error: unsupported HOST_PLATFORM=${HOST_PLATFORM}" >&2; exit 1 ;;
  esac
  echo "CIBW_BUILD=cp${PYTHON_VERSION_FORMATTED}-${CIBW_PLATFORM_TAG}" >> "$GITHUB_ENV"
  python -m ci.tools.bindings_config write-build-env "$GITHUB_ENV" \
    --repo-root "$REPO_DIR" --python-version "$PY_VER" \
    --host-platform "$HOST_PLATFORM" --sha "$SHA"
else
  TEST_CUDA_MAJOR="${CUDA_VER%%.*}"
  TEST_CUDA_MINOR="$(cut -d '.' -f 2 <<< "${CUDA_VER}")"
  PATHFINDER_SOURCE="${PATHFINDER_SOURCE:-artifact}"
  SKIP_CUDA_BINDINGS_TEST=1
  SKIP_CYTHON_TEST=1

  if [[ -z "${BINDINGS_CONFIG:-}" ]]; then
    # Old snapshots use main/backport/floor and generic13 artifacts until7.
    : "${BUILD_CUDA_VER:?BUILD_CUDA_VER is required for legacy snapshot routing}"
    CUDA_BINDINGS_ROOT=cuda_bindings_13
    if [[ ! -d "${CUDA_BINDINGS_ROOT}" ]]; then
      CUDA_BINDINGS_ROOT=cuda_bindings
    fi
    BINDINGS_BUILD_CUDA_VER="${BUILD_CUDA_VER}"
    build_minor="$(cut -d '.' -f 2 <<< "${BUILD_CUDA_VER}")"
    previous_minor="$(yq -r '.cuda.prev_build.version' ci/versions.yml | cut -d '.' -f 2)"
    if [[ "${BUILD_CUDA_VER%%.*}" != "${TEST_CUDA_MAJOR}" ]]; then
      BINDINGS_SOURCE=backport
      if [[ "${previous_minor}" != "${TEST_CUDA_MINOR}" ]]; then
        BINDINGS_SOURCE=floor
      fi
    elif [[ "${build_minor}" != "${TEST_CUDA_MINOR}" ]]; then
      BINDINGS_SOURCE=floor
    else
      BINDINGS_SOURCE=main
      SKIP_CUDA_BINDINGS_TEST="${SKIP_BINDINGS_TEST_OVERRIDE:-0}"
      SKIP_CYTHON_TEST=0
    fi
    CUDA_PYTHON_ARTIFACT_NAME=cuda-python-wheel
    core_cython_suffix=-tests
  else
    core_cython_suffix="-cu${TEST_CUDA_MAJOR}-tests"
    if [[ "${BINDINGS_SOURCE}" == local ]]; then
      CUDA_BINDINGS_ROOT="${BINDINGS_SOURCE_DIR}"
      BINDINGS_BUILD_CUDA_VER="${CUDA_VER}"
      SKIP_CUDA_BINDINGS_TEST="${SKIP_BINDINGS_TEST_OVERRIDE:-0}"
      SKIP_CYTHON_TEST=0
    elif [[ "${BINDINGS_SOURCE}" == floor ]]; then
      CUDA_BINDINGS_ROOT="${DEFAULT_BINDINGS_SOURCE_DIR}"
      BINDINGS_BUILD_CUDA_VER="${CUDA_VER}"
    else
      echo "Error: BINDINGS_SOURCE must be local or floor, got ${BINDINGS_SOURCE}" >&2
      exit 1
    fi
    CUDA_PYTHON_ARTIFACT_NAME="cuda-python-wheel-cuda${BINDINGS_BUILD_CUDA_VER}"
  fi

  CUDA_BINDINGS_ARTIFACT_BASENAME="cuda-bindings-python${PYTHON_VERSION_FORMATTED}-cuda${BINDINGS_BUILD_CUDA_VER}-${HOST_PLATFORM}"
  if [[ "${PY_VER}" == "3.12" && "${CUDA_VER}" != "11.8.0" && "${LOCAL_CTK}" == 1 && "${HOST_PLATFORM}" == linux* ]]; then
    echo "LATEST_CUDA_VERSION=$(bash "${CI_TOOLS_DIR}/guess_latest.sh" "$TEST_CUDA_MAJOR")" >> "$GITHUB_ENV"
    SETUP_SANITIZER=1
  else
    SETUP_SANITIZER=0
    echo "SANITIZER_CMD=" >> "$GITHUB_ENV"
  fi
  {
    echo "SETUP_SANITIZER=${SETUP_SANITIZER}"
    echo "BINDINGS_SOURCE=${BINDINGS_SOURCE}"
    echo "CUDA_BINDINGS_ROOT=${CUDA_BINDINGS_ROOT}"
    echo "PATHFINDER_SOURCE=${PATHFINDER_SOURCE}"
    echo "CUDA_PYTHON_ARTIFACT_NAME=${CUDA_PYTHON_ARTIFACT_NAME}"
    echo "SKIP_CUDA_BINDINGS_TEST=${SKIP_CUDA_BINDINGS_TEST}"
    echo "SKIP_CYTHON_TEST=${SKIP_CYTHON_TEST}"
    echo "TEST_CUDA_MAJOR=${TEST_CUDA_MAJOR}"
    echo "TEST_CUDA_MINOR=${TEST_CUDA_MINOR}"
    echo "CUDA_BINDINGS_ARTIFACT_BASENAME=${CUDA_BINDINGS_ARTIFACT_BASENAME}"
    echo "CUDA_BINDINGS_ARTIFACT_NAME=${CUDA_BINDINGS_ARTIFACT_BASENAME}-${SHA}"
    echo "CUDA_BINDINGS_ARTIFACTS_DIR=$(realpath "${REPO_DIR}/${CUDA_BINDINGS_ROOT}/dist")"
    echo "CUDA_BINDINGS_CYTHON_TESTS_DIR=$(realpath "${REPO_DIR}/${CUDA_BINDINGS_ROOT}/tests/cython")"
    echo "CUDA_CORE_CYTHON_TEST_ARTIFACT_NAME=${CUDA_CORE_ARTIFACT_NAME}${core_cython_suffix}"
  } >> "$GITHUB_ENV"
fi
